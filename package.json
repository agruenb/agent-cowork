{
  "name": "agent-cowork",
  "displayName": "Agent Cowork",
  "description": "%extension.description%",
  "version": "0.0.5",
  "publisher": "AdrianGruenberg",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agruenb/agent-cowork.git"
  },
  "bugs": {
    "url": "https://github.com/agruenb/agent-cowork/issues"
  },
  "homepage": "https://github.com/agruenb/agent-cowork#readme",
  "galleryBanner": {
    "color": "#059669",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "agents",
    "cowork",
    "markdown",
    "theme",
    "productivity",
    "simple"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onView:agentCowork.folderView",
    "onCommand:agent-cowork.openWorkspaceFolder",
    "onCommand:agent-cowork.toggleCoworkView",
    "onCustomEditor:agentCowork.markdownEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "agentCowork.markdownEditor",
        "displayName": "%customEditor.markdownEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkdn,mdx}"
          }
        ],
        "priority": "default"
      }
    ],
    "themes": [
      {
        "label": "Agent Cowork Light",
        "uiTheme": "vs",
        "path": "./themes/agent-cowork-light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "agent-cowork-icons",
        "label": "Agent Cowork Icons",
        "path": "./resources/icons/agent-cowork-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "agent-cowork.openWelcome",
        "category": "%command.category%",
        "title": "%command.openWelcome.title%"
      },
      {
        "command": "agent-cowork.helloWorld",
        "category": "%command.category%",
        "title": "%command.helloWorld.title%"
      },
      {
        "command": "agent-cowork.applyTheme",
        "category": "%command.category%",
        "title": "%command.applyTheme.title%"
      },
      {
        "command": "agent-cowork.simplifyLayout",
        "category": "%command.category%",
        "title": "%command.simplifyLayout.title%"
      },
      {
        "command": "agent-cowork.openWorkspaceFolder",
        "category": "%command.category%",
        "title": "%command.openWorkspaceFolder.title%"
      },
      {
        "command": "agent-cowork.refreshFolderView",
        "category": "%command.category%",
        "title": "%command.refreshFolderView.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-cowork.newFile",
        "category": "%command.category%",
        "title": "%command.newFile.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "agent-cowork.newFileInFolder",
        "category": "%command.category%",
        "title": "%command.newFile.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "agent-cowork.newFolder",
        "category": "%command.category%",
        "title": "%command.newFolder.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "agent-cowork.newFolderInFolder",
        "category": "%command.category%",
        "title": "%command.newFolder.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "agent-cowork.coworkWithFile",
        "category": "%command.category%",
        "title": "%command.coworkWithFile.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agent-cowork.coworkWithFolder",
        "category": "%command.category%",
        "title": "%command.coworkWithFolder.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agent-cowork.renameItem",
        "category": "%command.category%",
        "title": "%command.renameItem.title%",
        "icon": "$(edit)"
      },
      {
        "command": "agent-cowork.duplicateItem",
        "category": "%command.category%",
        "title": "%command.duplicateItem.title%",
        "icon": "$(copy)"
      },
      {
        "command": "agent-cowork.copyItem",
        "category": "%command.category%",
        "title": "%command.copyItem.title%",
        "icon": "$(files)"
      },
      {
        "command": "agent-cowork.cutItem",
        "category": "%command.category%",
        "title": "%command.cutItem.title%",
        "icon": "$(scissors)"
      },
      {
        "command": "agent-cowork.pasteItem",
        "category": "%command.category%",
        "title": "%command.pasteItem.title%",
        "icon": "$(clippy)"
      },
      {
        "command": "agent-cowork.deleteItem",
        "category": "%command.category%",
        "title": "%command.deleteItem.title%",
        "icon": "$(trash)"
      },
      {
        "command": "agent-cowork.toggleCoworkView",
        "category": "%command.category%",
        "title": "%command.toggleCoworkView.title%",
        "icon": "$(folder-library)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCoworkContainer",
          "title": "%viewContainer.agentCowork.title%",
          "icon": "$(folder-library)"
        }
      ]
    },
    "views": {
      "agentCoworkContainer": [
        {
          "id": "agentCowork.folderView",
          "name": "%view.folderView.name%",
          "icon": "$(folder-library)",
          "contextualTitle": "%view.folderView.contextualTitle%",
          "when": "config.agentCowork.coworkView"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentCowork.folderView",
        "contents": "%viewsWelcome.folderView.contents%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-cowork.newFile",
          "when": "view == agentCowork.folderView",
          "group": "navigation@1"
        },
        {
          "command": "agent-cowork.newFolder",
          "when": "view == agentCowork.folderView",
          "group": "navigation@2"
        },
        {
          "command": "agent-cowork.refreshFolderView",
          "when": "view == agentCowork.folderView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agent-cowork.newFileInFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "agent-cowork.newFolderInFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "inline@2"
        },
        {
          "command": "agent-cowork.coworkWithFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "inline@3"
        },
        {
          "command": "agent-cowork.coworkWithFile",
          "when": "view == agentCowork.folderView && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "agent-cowork.newFileInFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "1_new@1"
        },
        {
          "command": "agent-cowork.newFolderInFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "1_new@2"
        },
        {
          "command": "agent-cowork.renameItem",
          "when": "view == agentCowork.folderView && (viewItem == file || viewItem == folder)",
          "group": "2_modify@1"
        },
        {
          "command": "agent-cowork.duplicateItem",
          "when": "view == agentCowork.folderView && (viewItem == file || viewItem == folder)",
          "group": "2_modify@2"
        },
        {
          "command": "agent-cowork.copyItem",
          "when": "view == agentCowork.folderView && (viewItem == file || viewItem == folder)",
          "group": "3_clipboard@1"
        },
        {
          "command": "agent-cowork.cutItem",
          "when": "view == agentCowork.folderView && (viewItem == file || viewItem == folder)",
          "group": "3_clipboard@2"
        },
        {
          "command": "agent-cowork.pasteItem",
          "when": "view == agentCowork.folderView",
          "group": "3_clipboard@3"
        },
        {
          "command": "agent-cowork.deleteItem",
          "when": "view == agentCowork.folderView && (viewItem == file || viewItem == folder)",
          "group": "4_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agentCowork.coworkView": {
          "type": "boolean",
          "default": true,
          "description": "%config.coworkView%"
        },
        "agentCowork.showWelcomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.showWelcomeOnStartup%"
        },
        "agentCowork.simplifyLayout": {
          "type": "boolean",
          "default": true,
          "description": "%config.simplifyLayout%"
        },
        "agentCowork.browserTabs": {
          "type": "boolean",
          "default": true,
          "description": "%config.browserTabs%"
        },
        "agentCowork.hideGitAndDrawers": {
          "type": "boolean",
          "default": true,
          "description": "%config.hideGitAndDrawers%"
        },
        "agentCowork.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSave%"
        },
        "agentCowork.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.de%"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "build": "npm run compile",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "package-vsix": "vsce package",
    "publish-extension": "vsce publish",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "pretest": "npm run check-types",
    "test": "mocha -r tsx 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}