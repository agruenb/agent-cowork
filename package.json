{
  "name": "agent-cowork",
  "displayName": "Agent Cowork",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "AdrianGruenberg",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agruenb/agent-cowork.git"
  },
  "bugs": {
    "url": "https://github.com/agruenb/agent-cowork/issues"
  },
  "homepage": "https://github.com/agruenb/agent-cowork#readme",
  "galleryBanner": {
    "color": "#059669",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "agents",
    "cowork",
    "markdown",
    "theme",
    "productivity",
    "simple"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onView:agentCowork.folderView",
    "onCommand:agent-cowork.openWorkspaceFolder",
    "onCustomEditor:agentCowork.markdownEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "agentCowork.markdownEditor",
        "displayName": "%customEditor.markdownEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkdn,mdx}"
          }
        ],
        "priority": "default"
      }
    ],
    "themes": [
      {
        "label": "Agent Cowork Light",
        "uiTheme": "vs",
        "path": "./themes/agent-cowork-light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "agent-cowork-icons",
        "label": "Agent Cowork Icons",
        "path": "./resources/icons/agent-cowork-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "agent-cowork.openWelcome",
        "title": "%command.openWelcome.title%"
      },
      {
        "command": "agent-cowork.helloWorld",
        "title": "%command.helloWorld.title%"
      },
      {
        "command": "agent-cowork.applyTheme",
        "title": "%command.applyTheme.title%"
      },
      {
        "command": "agent-cowork.simplifyLayout",
        "title": "%command.simplifyLayout.title%"
      },
      {
        "command": "agent-cowork.openWorkspaceFolder",
        "title": "%command.openWorkspaceFolder.title%"
      },
      {
        "command": "agent-cowork.refreshFolderView",
        "title": "%command.refreshFolderView.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-cowork.newFile",
        "title": "%command.newFile.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "agent-cowork.newFileInFolder",
        "title": "%command.newFile.title%",
        "icon": "$(new-file)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCoworkContainer",
          "title": "%viewContainer.agentCowork.title%",
          "icon": "$(folder-library)"
        }
      ]
    },
    "views": {
      "agentCoworkContainer": [
        {
          "id": "agentCowork.folderView",
          "name": "%view.folderView.name%",
          "icon": "$(folder-library)",
          "contextualTitle": "%view.folderView.contextualTitle%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentCowork.folderView",
        "contents": "%viewsWelcome.folderView.contents%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-cowork.newFile",
          "when": "view == agentCowork.folderView",
          "group": "navigation@1"
        },
        {
          "command": "agent-cowork.refreshFolderView",
          "when": "view == agentCowork.folderView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agent-cowork.newFileInFolder",
          "when": "view == agentCowork.folderView && viewItem == folder",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agentCowork.showWelcomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.showWelcomeOnStartup%"
        },
        "agentCowork.simplifyLayout": {
          "type": "boolean",
          "default": true,
          "description": "%config.simplifyLayout%"
        },
        "agentCowork.browserTabs": {
          "type": "boolean",
          "default": true,
          "description": "%config.browserTabs%"
        },
        "agentCowork.hideGitAndDrawers": {
          "type": "boolean",
          "default": true,
          "description": "%config.hideGitAndDrawers%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "package-vsix": "vsce package",
    "publish-extension": "vsce publish",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  }
}