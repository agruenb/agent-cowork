    "editor.foreground": "#e2e8f0",
    "editorLineNumber.foreground": "#475569",
    "editorLineNumber.activeForeground": "#f8fafc",
    "editorCursor.foreground": "#38bdf8",
    "editor.selectionBackground": "#33415590",
    "editor.inactiveSelectionBackground": "#1e293b80",
    "editor.selectionHighlightBackground": "#33415550",
    "editor.wordHighlightBackground": "#33415560",
    "editor.findMatchBackground": "#38bdf850",
    "editor.findMatchHighlightBackground": "#33415560",
    "editor.lineHighlightBackground": "#1e293b50",
    "editor.lineHighlightBorder": "#1e293b",
    "editorBracketMatch.background": "#33415550",
    "editorBracketMatch.border": "#64748b",
    "editorIndentGuide.background": "#1e293b",
    "editorIndentGuide.activeBackground": "#475569",
    "editorGutter.background": "#0f172a",
    "editorGutter.modifiedBackground": "#38bdf8",
    "editorGutter.addedBackground": "#22c55e",
    "editorGutter.deletedBackground": "#f87171",
    "statusBar.background": "#020617",
    "statusBar.foreground": "#94a3b8",
    "statusBar.border": "#1e293b",
    "statusBar.debuggingBackground": "#020617",
    "statusBar.debuggingForeground": "#94a3b8",
    "statusBar.debuggingBorder": "#1e293b",
    "statusBar.noFolderBackground": "#020617",
    "statusBar.noFolderForeground": "#94a3b8",
    "statusBar.noFolderBorder": "#1e293b",
    "statusBarItem.hoverBackground": "#1e293b",
    "statusBarItem.hoverForeground": "#f8fafc",
    "statusBarItem.activeBackground": "#334155",
    "statusBarItem.remoteBackground": "#1e293b",
    "statusBarItem.remoteForeground": "#f8fafc",
    "titleBar.activeBackground": "#020617",
    "titleBar.activeForeground": "#e2e8f0",
    "titleBar.inactiveBackground": "#020617",
    "titleBar.inactiveForeground": "#64748b",
    "titleBar.border": "#1e293b",
