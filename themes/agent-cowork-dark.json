    "button.secondaryBackground": "#1e293b",
    "button.secondaryForeground": "#e2e8f0",
    "button.secondaryHoverBackground": "#334155",
    "badge.background": "#38bdf8",
    "badge.foreground": "#0f172a",
    "input.background": "#0f172a",
    "input.foreground": "#f8fafc",
    "input.border": "#334155",
    "inputOption.activeBorder": "#38bdf8",
    "inputOption.activeBackground": "#1e293b",
    "inputOption.activeForeground": "#38bdf8",
    "inputValidation.infoBorder": "#38bdf8",
    "inputValidation.warningBorder": "#f59e0b",
    "inputValidation.errorBorder": "#ef4444",
    "dropdown.background": "#0f172a",
    "dropdown.foreground": "#f8fafc",
    "dropdown.border": "#334155",
    "list.activeSelectionBackground": "#1e293b",
    "list.activeSelectionForeground": "#f8fafc",
    "list.activeSelectionIconForeground": "#f8fafc",
    "list.inactiveSelectionBackground": "#00000000",
    "list.inactiveSelectionForeground": "#f8fafc",
    "list.inactiveSelectionIconForeground": "#f8fafc",
    "list.focusBackground": "#1e293b",
    "list.focusForeground": "#f8fafc",
    "list.focusOutline": "#00000000",
    "list.focusAndSelectionOutline": "#00000000",
    "list.hoverBackground": "#1e293b",
    "list.hoverForeground": "#f8fafc",
    "list.focusHighlightForeground": "#38bdf8",
    "list.highlightForeground": "#38bdf8",
    "pickerGroup.border": "#1e293b",
    "pickerGroup.foreground": "#38bdf8",
    "quickInput.background": "#0f172a",
    "quickInput.foreground": "#e2e8f0",
    "panel.background": "#0f172a",
    "panel.border": "#1e293b",
    "panelTitle.activeBorder": "#38bdf8",
    "panelTitle.activeForeground": "#f8fafc",
    "panelTitle.inactiveForeground": "#94a3b8",
    "terminal.foreground": "#e2e8f0",
    "terminal.ansiGreen": "#22c55e",
    "terminal.ansiBrightGreen": "#4ade80",
    "terminalCursor.foreground": "#38bdf8",
    "breadcrumb.foreground": "#94a3b8",
    "breadcrumb.focusForeground": "#f8fafc",
    "breadcrumb.activeSelectionForeground": "#f8fafc",
    "breadcrumbPicker.background": "#0f172a",
    "charts.yellow": "#fbbf24"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f8fafc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#f8fafc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Numbers and Booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#818cf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#e2e8f0"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#94a3b8"
      }
    },
    {
      "name": "HTML/JSX Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#f8fafc"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#94a3b8"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#f8fafc",
        "fontStyle": "bold"
      }
    }
  ]
}
