    "sideBarSectionHeader.border": "#1e293b",
    "editorGroupHeader.tabsBackground": "#020617",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.border": "#00000000",
    "editorGroup.border": "#1e293b",
    "tab.activeBackground": "#0f172a",
